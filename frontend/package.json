{
  "name": "feature-freshness-monitor-ryan-vo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:integration": "esbuild tests/browser-entry.tsx --bundle --jsx=automatic --format=esm --outfile=tests/react-app.js && node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "oidc-client-ts": "3.5.0",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.4",
    "playwright": "1.64.0",
    "esbuild": "0.28.2"
  },
  "author": "Ryan Vo <ryandtvo@gmail.com>",
  "license": "MIT"
}
